-- =========================
-- TABLA: departamentos
-- =========================
CREATE TABLE departamentos (
    id SERIAL PRIMARY KEY,
    nombre VARCHAR(100) UNIQUE NOT NULL,
    creado_en TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP
);

-- =========================
-- TABLA: puestos
-- =========================
CREATE TABLE puestos (
    id SERIAL PRIMARY KEY,
    nombre VARCHAR(100) UNIQUE NOT NULL,
    creado_en TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP
);

-- =========================
-- TABLA: empleados
-- =========================
CREATE TABLE empleados (
    id SERIAL PRIMARY KEY,
    dpi VARCHAR(20) UNIQUE NOT NULL,
    nombres VARCHAR(100) NOT NULL,
    apellidos VARCHAR(100) NOT NULL,
    fecha_nacimiento DATE,
    direccion TEXT,
    telefono VARCHAR(20),
    salario_base DECIMAL(10,2) NOT NULL,

    puesto_id INT,
    departamento_id INT,

    estado VARCHAR(20) NOT NULL CHECK (
        estado IN ('ACTIVO','SUSPENDIDO','RETIRADO')
    ),

    creado_en TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,

    CONSTRAINT fk_empleado_puesto
        FOREIGN KEY (puesto_id)
        REFERENCES puestos(id)
        ON DELETE SET NULL,

    CONSTRAINT fk_empleado_departamento
        FOREIGN KEY (departamento_id)
        REFERENCES departamentos(id)
        ON DELETE SET NULL
);

-- =========================
-- TABLA: usuarios
-- =========================
CREATE TABLE usuarios (
    id SERIAL PRIMARY KEY,
    correo VARCHAR(150) UNIQUE NOT NULL,
    contrasena VARCHAR(255) NOT NULL,

    rol VARCHAR(20) NOT NULL CHECK (
        rol IN ('ADMIN','RRHH','EMPLEADO')
    ),

    empleado_id INT UNIQUE,

    creado_en TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,

    CONSTRAINT fk_usuario_empleado
        FOREIGN KEY (empleado_id)
        REFERENCES empleados(id)
        ON DELETE SET NULL
);

-- =========================
-- TABLA: registros_academicos
-- =========================
CREATE TABLE registros_academicos (
    id SERIAL PRIMARY KEY,

    empleado_id INT NOT NULL,

    tipo VARCHAR(20) NOT NULL CHECK (
        tipo IN ('TITULO','CERTIFICACION')
    ),

    titulo VARCHAR(150) NOT NULL,
    institucion VARCHAR(150) NOT NULL,
    fecha_graduacion DATE,

    CONSTRAINT fk_academico_empleado
        FOREIGN KEY (empleado_id)
        REFERENCES empleados(id)
        ON DELETE CASCADE
);

-- =========================
-- TABLA: tipos_documento
-- =========================
CREATE TABLE tipos_documento (
    id SERIAL PRIMARY KEY,
    nombre VARCHAR(100) NOT NULL,
    es_obligatorio BOOLEAN NOT NULL
);

-- =========================
-- TABLA: documentos
-- =========================
CREATE TABLE documentos (
    id SERIAL PRIMARY KEY,

    empleado_id INT NOT NULL,
    tipo_documento_id INT NOT NULL,

    nombre_archivo VARCHAR(255) NOT NULL,
    url_archivo VARCHAR(255) NOT NULL,

    subido_en TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,

    subido_por_usuario_id INT,

    CONSTRAINT fk_documento_empleado
        FOREIGN KEY (empleado_id)
        REFERENCES empleados(id)
        ON DELETE CASCADE,

    CONSTRAINT fk_documento_tipo
        FOREIGN KEY (tipo_documento_id)
        REFERENCES tipos_documento(id),

    CONSTRAINT fk_documento_usuario
        FOREIGN KEY (subido_por_usuario_id)
        REFERENCES usuarios(id)
        ON DELETE SET NULL
);

-- =========================
-- TABLA: periodos_nomina
-- =========================
CREATE TABLE periodos_nomina (
    id SERIAL PRIMARY KEY,

    fecha_inicio DATE NOT NULL,
    fecha_fin DATE NOT NULL,

    estado VARCHAR(20) NOT NULL CHECK (
        estado IN ('ABIERTO','CERRADO')
    ),

    creado_en TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP
);

-- =========================
-- TABLA: detalles_nomina
-- =========================
CREATE TABLE detalles_nomina (
    id SERIAL PRIMARY KEY,

    periodo_nomina_id INT NOT NULL,
    empleado_id INT NOT NULL,

    salario_base_snapshot DECIMAL(10,2),
    horas_extra INT,
    monto_horas_extra DECIMAL(10,2),
    bonificaciones DECIMAL(10,2),
    deducciones_total DECIMAL(10,2),

    salario_neto DECIMAL(10,2) NOT NULL,

    creado_en TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,

    CONSTRAINT fk_detalle_periodo
        FOREIGN KEY (periodo_nomina_id)
        REFERENCES periodos_nomina(id)
        ON DELETE CASCADE,

    CONSTRAINT fk_detalle_empleado
        FOREIGN KEY (empleado_id)
        REFERENCES empleados(id)
        ON DELETE CASCADE,

    CONSTRAINT unique_nomina_empleado
        UNIQUE (periodo_nomina_id, empleado_id)
);

-- =========================
-- TABLA: ajustes_nomina
-- =========================
CREATE TABLE ajustes_nomina (
    id SERIAL PRIMARY KEY,

    detalle_nomina_id INT NOT NULL,
    ajustado_por_usuario_id INT,

    monto_anterior DECIMAL(10,2),
    monto_nuevo DECIMAL(10,2),

    razon TEXT,

    cambiado_en TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,

    CONSTRAINT fk_ajuste_detalle
        FOREIGN KEY (detalle_nomina_id)
        REFERENCES detalles_nomina(id)
        ON DELETE CASCADE,

    CONSTRAINT fk_ajuste_usuario
        FOREIGN KEY (ajustado_por_usuario_id)
        REFERENCES usuarios(id)
        ON DELETE SET NULL
);

-- =========================
-- TABLA: auditoria_logs
-- =========================
CREATE TABLE auditoria_logs (
    id SERIAL PRIMARY KEY,

    usuario_id INT,

    accion VARCHAR(50) NOT NULL,
    entidad VARCHAR(100) NOT NULL,
    entidad_id INT,

    descripcion TEXT,

    creado_en TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,

    CONSTRAINT fk_log_usuario
        FOREIGN KEY (usuario_id)
        REFERENCES usuarios(id)
        ON DELETE SET NULL
);


